#!/usr/bin/env python3
"""Run the large-filter correctness smoke matrix in owned OrbStack containers.

This entry point is intentionally incapable of native timing.  It accepts only
locally supplied Fedora 42 389 DS RPMs, creates linux/amd64 containers under
OrbStack/Rosetta, and delegates every search to ``bin/run-study`` in
``correctness-only`` mode.  Numeric measurements produced along the way are
non-release execution artifacts and must not be used for timing claims.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Mapping, Sequence


