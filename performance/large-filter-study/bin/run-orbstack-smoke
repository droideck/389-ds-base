class SmokeError(RuntimeError):
    """A user-facing smoke orchestration failure."""


@dataclass(frozen=True)
class RunSpec:
    name: str
    server: str
    lookup: str
    index_config: str
    scenarios: tuple[str, ...]


RUN_SPECS = (
    RunSpec(
        "389ds-lookup-on-baseline",
        "389ds",
        "on",
        "baseline-no-presence",
        BASELINE_SCENARIOS,
    ),
    RunSpec(
        "389ds-lookup-off-subset",
